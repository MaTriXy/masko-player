{
  "name": "let-go-waits-for-the-loop-end-unless-instant",
  "about": "Letting go is a value like any other: the way back waits for the end of the held loop, and starts at once, playing its move, when the app lets go with instant.",
  "rules": ["5.3", "5.8"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "set": ["heldContact", true],
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-held-contact-squish",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "enter-held-contact-squish",
        "next": null,
        "events": ["shown:enter-held-contact-squish"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 5333,
        "pose": "held-contact-squish",
        "clip": "loop-held-contact-squish",
        "next": null,
        "events": ["pose:held-contact-squish", "shown:loop-held-contact-squish"]
      }
    },
    {
      "advance": 500,
      "expect": {
        "clock": 5833,
        "pose": "held-contact-squish",
        "clip": "loop-held-contact-squish",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["heldContact", false],
      "expect": {
        "clock": 5833,
        "pose": "held-contact-squish",
        "clip": "loop-held-contact-squish",
        "next": {
          "clip": "return-held-contact-squish",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "set": ["heldContact", false],
      "instant": true,
      "expect": {
        "clock": 5833,
        "pose": "held-contact-squish",
        "clip": "return-held-contact-squish",
        "next": null,
        "events": ["shown:return-held-contact-squish"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 7500,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    }
  ]
}
