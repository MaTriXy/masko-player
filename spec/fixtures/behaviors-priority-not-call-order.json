{
  "name": "behaviors-priority-not-call-order",
  "about": "Working, then attention over it, then attention off falls back to working by itself.",
  "rules": ["3.2", "4.1", "4.2", "6.2", "6.4"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": ["shown:enter-laptop-working"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 6286,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": ["pose:laptop-working", "shown:loop-laptop-working"]
      }
    },
    {
      "advance": 500,
      "expect": {
        "clock": 6786,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["attention", true],
      "expect": {
        "clock": 6786,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": {
          "clip": "return-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 10286,
        "pose": "laptop-working",
        "clip": "return-laptop-working",
        "next": null,
        "events": ["shown:return-laptop-working"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 13045,
        "pose": "idle",
        "clip": "enter-fan-wave",
        "next": null,
        "events": ["pose:idle", "shown:enter-fan-wave"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 15045,
        "pose": "fan-wave",
        "clip": "loop-fan-wave",
        "next": null,
        "events": ["pose:fan-wave", "shown:loop-fan-wave"]
      }
    },
    {
      "set": ["attention", false],
      "expect": {
        "clock": 15045,
        "pose": "fan-wave",
        "clip": "loop-fan-wave",
        "next": {
          "clip": "return-fan-wave",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 19045,
        "pose": "fan-wave",
        "clip": "return-fan-wave",
        "next": null,
        "events": ["shown:return-fan-wave"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 21045,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": ["pose:idle", "shown:enter-laptop-working"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 23331,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": ["pose:laptop-working", "shown:loop-laptop-working"]
      }
    }
  ]
}
