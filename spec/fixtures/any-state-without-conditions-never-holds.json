{
  "name": "any-state-without-conditions-never-holds",
  "about": "An Any State edge with no conditions never pulls the mascot.",
  "rules": ["4.1"],
  "canvas": {
    "deliverySchemaVersion": 1,
    "playerContract": 1,
    "requires": ["any-state", "condition-groups"],
    "target": "web",
    "mode": "selected",
    "runtimeGraph": {
      "runtimeGraphSchemaVersion": 1,
      "version": "2.1",
      "name": "scenario",
      "initialNode": "a",
      "autoPlay": true,
      "nodes": [
        {
          "id": "a",
          "name": "a"
        },
        {
          "id": "b",
          "name": "b"
        }
      ],
      "edges": [
        {
          "id": "loop-a",
          "source": "a",
          "target": "a",
          "isLoop": true,
          "duration": 4,
          "videos": {
            "hevc": "https://example.invalid/loop-a.mov",
            "webm": "https://example.invalid/loop-a.webm"
          }
        },
        {
          "id": "loop-b",
          "source": "b",
          "target": "b",
          "isLoop": true,
          "duration": 4,
          "videos": {
            "hevc": "https://example.invalid/loop-b.mov",
            "webm": "https://example.invalid/loop-b.webm"
          }
        },
        {
          "id": "a-to-b",
          "source": "a",
          "target": "b",
          "isLoop": false,
          "duration": 1,
          "videos": {
            "hevc": "https://example.invalid/a-to-b.mov",
            "webm": "https://example.invalid/a-to-b.webm"
          },
          "conditions": [
            {
              "input": "action::go",
              "op": "==",
              "value": true
            }
          ]
        },
        {
          "id": "any-b",
          "source": "*",
          "target": "b",
          "isLoop": false,
          "duration": 0,
          "videos": {}
        }
      ],
      "inputs": []
    }
  },
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": ["pose:a", "shown:loop-a"]
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": ["shown:loop-a"]
      }
    }
  ]
}
