{
  "name": "hover-waits-for-the-loop-end",
  "about": "The pointer over the mascot is a value like any other: its move waits for the end of the loop on screen, and so does the way back when it leaves.",
  "rules": ["3.5", "5.3"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "advance": 1500,
      "expect": {
        "clock": 1500,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["behavior::pointerHover", true],
      "expect": {
        "clock": 1500,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-hover-perk",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "enter-hover-perk",
        "next": null,
        "events": ["shown:enter-hover-perk"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 5600,
        "pose": "hover-perk",
        "clip": "loop-hover-perk",
        "next": null,
        "events": ["pose:hover-perk", "shown:loop-hover-perk"]
      }
    },
    {
      "advance": 1000,
      "expect": {
        "clock": 6600,
        "clip": "loop-hover-perk",
        "events": []
      }
    },
    {
      "set": ["behavior::pointerHover", false],
      "expect": {
        "clock": 6600,
        "pose": "hover-perk",
        "clip": "loop-hover-perk",
        "next": {
          "clip": "return-hover-perk",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 9600,
        "pose": "hover-perk",
        "clip": "return-hover-perk",
        "next": null,
        "events": ["shown:return-hover-perk"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 11418,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    }
  ]
}
