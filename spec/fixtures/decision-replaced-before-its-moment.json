{
  "name": "decision-replaced-before-its-moment",
  "about": "A higher move decided before the loop end replaces the first.",
  "rules": ["5.6"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "advance": 300,
      "expect": {
        "clock": 300,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 300,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "advance": 500,
      "expect": {
        "clock": 800,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "set": ["attention", true],
      "expect": {
        "clock": 800,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-fan-wave",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "enter-fan-wave",
        "next": null,
        "events": ["shown:enter-fan-wave"]
      }
    }
  ]
}
