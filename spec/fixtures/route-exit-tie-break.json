  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": ["pose:a", "shown:loop-a"]
      }
    },
    {
      "set": ["go", true],
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": {
          "clip": "a-to-hub2",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "set": ["x", true],
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": {
          "clip": "a-to-hub1",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "a",
        "clip": "a-to-hub1",
        "next": null,
        "events": ["shown:a-to-hub1"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 6000,
        "pose": "hub1",
        "clip": "hub1-to-t",
        "next": null,
        "events": ["pose:hub1", "shown:hub1-to-t"]
