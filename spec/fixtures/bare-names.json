{
  "name": "bare-names",
  "about": "Bare names resolve to a declared name, then a behavior family, then an action.",
  "rules": ["3.1"],
  "canvas": {
    "deliverySchemaVersion": 1,
    "playerContract": 1,
    "requires": ["any-state", "condition-groups"],
    "target": "web",
    "mode": "selected",
    "runtimeGraph": {
      "runtimeGraphSchemaVersion": 1,
      "version": "2.1",
      "name": "scenario",
      "initialNode": "a",
      "autoPlay": true,
      "nodes": [
        {
          "id": "a",
          "name": "a"
        },
        {
          "id": "b",
          "name": "b"
        }
      ],
      "edges": [
        {
          "id": "loop-a",
          "source": "a",
          "target": "a",
          "isLoop": true,
          "duration": 4,
          "videos": {
            "hevc": "https://example.invalid/loop-a.mov",
            "webm": "https://example.invalid/loop-a.webm"
          }
        },
        {
          "id": "loop-b",
          "source": "b",
          "target": "b",
          "isLoop": true,
          "duration": 4,
          "videos": {
            "hevc": "https://example.invalid/loop-b.mov",
            "webm": "https://example.invalid/loop-b.webm"
          }
        },
        {
          "id": "a-to-b",
          "source": "a",
          "target": "b",
          "isLoop": false,
          "duration": 1,
          "videos": {
            "hevc": "https://example.invalid/a-to-b.mov",
            "webm": "https://example.invalid/a-to-b.webm"
          },
          "conditions": [
            {
              "input": "score",
              "op": ">=",
              "value": 3
            }
          ]
        }
      ],
      "inputs": [
        {
          "name": "score",
          "type": "number",
          "default": 0
        }
      ]
    }
  },
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": ["pose:a", "shown:loop-a"]
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": [],
        "values": {
          "behavior::working": true
        }
      }
    },
    {
      "fire": "wave",
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": [],
        "fired": ["action::wave"]
      }
    },
    {
      "set": ["score", 3],
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": {
          "clip": "a-to-b",
          "at": "end"
        },
        "events": [],
        "values": {
          "score": 3
        }
      }
    }
  ]
}
