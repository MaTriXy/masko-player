{
  "name": "fire-unwanted-is-dropped-at-once",
  "about": "A fire that no start and no named clip wants is dropped at once, reported unused; it never waits for a later moment.",
  "rules": ["3.3"],
  "canvas": "otto",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "advance": 1000,
      "expect": {
        "clock": 1000,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": []
      }
    },
    {
      "fire": "wave",
      "expect": {
        "clock": 1000,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["spent:action::wave:unused"],
        "fired": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["shown:loop-idle"],
        "fired": []
      }
    }
  ]
}
