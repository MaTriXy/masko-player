{
  "name": "named-clip-while-held",
  "about": "A named pose clip plays while its name is held, from arrival on.",
  "rules": ["7.1", "7.2"],
  "canvas": "ko-coffee",
  "patch": {
    "addEdges": [
      {
        "id": "loop-laptop-reading",
        "source": "laptop-working",
        "target": "laptop-working",
        "isLoop": true,
        "duration": 4,
        "videos": {
          "hevc": "https://example.invalid/loop-laptop-reading.mov",
          "webm": "https://example.invalid/loop-laptop-reading.webm"
        },
        "conditions": [
          {
            "input": "action::reading",
            "op": "==",
            "value": true
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "set": ["reading", true],
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": ["shown:enter-laptop-working"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 6286,
        "pose": "laptop-working",
        "clip": "loop-laptop-reading",
        "next": null,
        "events": ["pose:laptop-working", "shown:loop-laptop-reading"]
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 10286,
        "pose": "laptop-working",
        "clip": "loop-laptop-reading",
        "next": null,
        "events": ["shown:loop-laptop-reading"]
      }
    },
    {
      "set": ["reading", false],
      "expect": {
        "clock": 10286,
        "pose": "laptop-working",
        "clip": "loop-laptop-reading",
        "next": null,
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 14286,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": ["shown:loop-laptop-working"]
      }
    }
  ]
}
