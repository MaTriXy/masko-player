{
  "name": "grab-during-a-move-waits-for-its-end",
  "about": "A grab during a move lets the move finish; at its end, a boundary, the way to the held pose starts at once, hop after hop. Letting go then starts the way back at once.",
  "rules": ["10.2", "5.2", "6.4"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": ["shown:enter-laptop-working"]
      }
    },
    {
      "advance": 1000,
      "expect": {
        "clock": 5000,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["heldContact", true],
      "expect": {
        "clock": 5000,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": []
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 6286,
        "pose": "laptop-working",
        "clip": "return-laptop-working",
        "next": null,
        "events": ["pose:laptop-working", "shown:return-laptop-working"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 9045,
        "pose": "idle",
        "clip": "enter-held-contact-squish",
        "next": null,
        "events": ["pose:idle", "shown:enter-held-contact-squish"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 10378,
        "pose": "held-contact-squish",
        "clip": "loop-held-contact-squish",
        "next": null,
        "events": ["pose:held-contact-squish", "shown:loop-held-contact-squish"]
      }
    },
    {
      "advance": 500,
      "expect": {
        "clock": 10878,
        "pose": "held-contact-squish",
        "clip": "loop-held-contact-squish",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["heldContact", false],
      "expect": {
        "clock": 10878,
        "pose": "held-contact-squish",
        "clip": "return-held-contact-squish",
        "next": null,
        "events": ["shown:return-held-contact-squish"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 12545,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": ["pose:idle", "shown:enter-laptop-working"]
      }
    }
  ]
}
