{
  "name": "instant-value-stays-until-set-again",
  "about": "A value set with instant stays instant while it holds: the way back to its pose later enters it at once; a later set without instant ends that.",
  "rules": ["5.8", "3.2"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "set": ["working", true],
      "instant": true,
      "expect": {
        "clock": 0,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": ["pose:laptop-working", "shown:loop-laptop-working"]
      }
    },
    {
      "set": ["attention", true],
      "expect": {
        "clock": 0,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": {
          "clip": "return-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "laptop-working",
        "clip": "return-laptop-working",
        "next": null,
        "events": ["shown:return-laptop-working"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 6759,
        "pose": "idle",
        "clip": "enter-fan-wave",
        "next": null,
        "events": ["pose:idle", "shown:enter-fan-wave"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 8759,
        "pose": "fan-wave",
        "clip": "loop-fan-wave",
        "next": null,
        "events": ["pose:fan-wave", "shown:loop-fan-wave"]
      }
    },
    {
      "set": ["attention", false],
      "expect": {
        "clock": 8759,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": ["pose:laptop-working", "shown:loop-laptop-working"]
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 8759,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["attention", true],
      "expect": {
        "clock": 8759,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": {
          "clip": "return-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 12759,
        "pose": "laptop-working",
        "clip": "return-laptop-working",
        "next": null,
        "events": ["shown:return-laptop-working"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 15518,
        "pose": "idle",
        "clip": "enter-fan-wave",
        "next": null,
        "events": ["pose:idle", "shown:enter-fan-wave"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 17518,
        "pose": "fan-wave",
        "clip": "loop-fan-wave",
        "next": null,
        "events": ["pose:fan-wave", "shown:loop-fan-wave"]
      }
    },
    {
      "set": ["attention", false],
      "expect": {
        "clock": 17518,
        "pose": "fan-wave",
        "clip": "loop-fan-wave",
        "next": {
          "clip": "return-fan-wave",
          "at": "end"
        },
        "events": []
      }
    }
  ]
}
