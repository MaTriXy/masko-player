{
  "name": "after-it-plays-once",
  "about": "\"After it plays once\" (loopCount >= 1) shows a pose once before moving on.",
  "rules": ["5.7", "8.1"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "fire": "papercraftGift",
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-paper-fold",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "enter-paper-fold",
        "next": null,
        "events": ["shown:enter-paper-fold"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 6286,
        "pose": "paper-fold",
        "clip": "loop-paper-fold",
        "next": null,
        "events": ["pose:paper-fold", "shown:loop-paper-fold"]
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 10286,
        "pose": "paper-fold",
        "clip": "paper-fold-to-paper-crane",
        "next": null,
        "events": ["spent:action::papercraftGift", "shown:paper-fold-to-paper-crane"],
        "fired": []
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 13363,
        "pose": "paper-crane",
        "clip": "loop-paper-crane",
        "next": null,
        "events": ["pose:paper-crane", "shown:loop-paper-crane"]
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 17363,
        "pose": "paper-crane",
        "clip": "paper-crane-to-paper-crane-fly",
        "next": null,
        "events": ["shown:paper-crane-to-paper-crane-fly"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 20440,
        "pose": "paper-crane-fly",
        "clip": "loop-paper-crane-fly",
        "next": null,
        "events": ["pose:paper-crane-fly", "shown:loop-paper-crane-fly"]
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 24440,
        "pose": "paper-crane-fly",
        "clip": "return-paper-crane-fly",
        "next": null,
        "events": ["shown:return-paper-crane-fly"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 26940,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    }
  ]
}
