{
  "name": "instant-cuts-the-move-to-its-own-target",
  "about": "Setting the value a move is playing for again with instant cuts that move and enters its target at once.",
  "rules": ["5.8", "3.2", "10.1"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "enter-laptop-working",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": ["shown:enter-laptop-working"]
      }
    },
    {
      "advance": 1000,
      "expect": {
        "clock": 5000,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["working", true],
      "instant": true,
      "expect": {
        "clock": 5000,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": ["interrupted:enter-laptop-working", "pose:laptop-working", "shown:loop-laptop-working"]
      }
    }
  ]
}
