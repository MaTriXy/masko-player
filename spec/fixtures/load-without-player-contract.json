{
  "name": "load-without-player-contract",
  "about": "A delivery made before playerContract existed reads as contract 1.",
  "rules": ["1.2"],
  "canvas": {
    "deliverySchemaVersion": 1,
    "playerContract": 1,
    "requires": ["any-state", "condition-groups"],
    "target": "web",
    "mode": "selected",
    "runtimeGraph": {
      "runtimeGraphSchemaVersion": 1,
      "version": "2.1",
      "name": "scenario",
      "initialNode": "idle",
      "autoPlay": true,
      "nodes": [
        {
          "id": "idle",
          "name": "idle"
        }
      ],
      "edges": [
        {
          "id": "loop-idle",
