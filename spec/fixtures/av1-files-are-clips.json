{
  "name": "av1-files-are-clips",
  "about": "An AV1 file, on its own or in a size of variants, is a clip like the other formats.",
  "rules": ["1.4"],
  "canvas": "otto",
  "patch": {
    "edges": {
      "idle-to-watching": {
        "videos": {
          "hevc": null,
          "webm": null,
          "av1": "https://example.invalid/idle-to-watching.mp4"
        }
      },
      "loop-watching": {
        "videos": {
          "hevc": null,
          "webm": null,
          "variants": {
            "256": {
              "av1": "https://example.invalid/loop-watching-256.mp4"
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "next": {
          "clip": "idle-to-watching",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "idle-to-watching",
        "events": ["shown:idle-to-watching"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "pose": "watching",
        "clip": "loop-watching",
        "events": ["pose:watching", "shown:loop-watching"]
      }
    }
  ]
}
