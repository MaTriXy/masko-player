  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": ["pose:a", "shown:loop-a"],
        "preloaded": ["a-to-e", "a-to-c", "a-to-b"]
      }
    },
    {
      "set": ["x", true],
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": {
          "clip": "a-to-b",
          "at": "end"
        },
        "events": [],
        "preloaded": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "a",
        "clip": "a-to-b",
        "next": null,
        "events": ["shown:a-to-b"],
        "preloaded": ["loop-b"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 5000,
        "pose": "b",
        "clip": "loop-b",
        "next": null,
        "events": ["pose:b", "shown:loop-b"],
        "preloaded": ["b-to-a"]
      }
    }
