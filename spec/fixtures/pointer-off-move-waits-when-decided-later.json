{
  "name": "pointer-off-move-waits-when-decided-later",
  "about": "Only the decision made as the pointer leaves starts at once: a move on pointerHover == false decided later waits for the end of the loop, and a start decided before the pointer passed keeps its moment.",
  "rules": ["5.2", "5.3", "5.6"],
  "canvas": {
    "deliverySchemaVersion": 1,
    "playerContract": 1,
    "requires": [],
    "target": "web",
    "mode": "selected",
    "runtimeGraph": {
      "runtimeGraphSchemaVersion": 1,
      "version": "2.1",
      "name": "scenario",
      "initialNode": "a",
      "autoPlay": true,
      "nodes": [
        {
          "id": "a",
          "name": "a"
        },
        {
          "id": "b",
          "name": "b"
        },
        {
          "id": "c",
          "name": "c"
        }
      ],
      "edges": [
        {
          "id": "loop-a",
          "source": "a",
          "target": "a",
          "isLoop": true,
          "duration": 4,
          "videos": {
            "hevc": "https://example.invalid/loop-a.mov",
            "webm": "https://example.invalid/loop-a.webm"
          }
        },
        {
          "id": "loop-b",
          "source": "b",
          "target": "b",
          "isLoop": true,
          "duration": 4,
          "videos": {
            "hevc": "https://example.invalid/loop-b.mov",
            "webm": "https://example.invalid/loop-b.webm"
          }
        },
        {
          "id": "loop-c",
          "source": "c",
          "target": "c",
          "isLoop": true,
          "duration": 4,
          "videos": {
            "hevc": "https://example.invalid/loop-c.mov",
            "webm": "https://example.invalid/loop-c.webm"
          }
        },
        {
          "id": "a-to-b",
          "source": "a",
          "target": "b",
          "isLoop": false,
          "duration": 1,
          "videos": {
            "hevc": "https://example.invalid/a-to-b.mov",
            "webm": "https://example.invalid/a-to-b.webm"
          },
          "conditions": [
            {
              "input": "behavior::pointerHover",
              "op": "==",
              "value": true
            }
          ]
        },
        {
          "id": "b-to-a",
          "source": "b",
          "target": "a",
          "isLoop": false,
          "duration": 1,
          "videos": {
            "hevc": "https://example.invalid/b-to-a.mov",
            "webm": "https://example.invalid/b-to-a.webm"
          },
          "conditions": [
            {
              "input": "behavior::pointerHover",
              "op": "==",
              "value": false
            }
          ]
        },
        {
          "id": "a-to-c",
          "source": "a",
          "target": "c",
          "isLoop": false,
          "duration": 1,
          "videos": {
            "hevc": "https://example.invalid/a-to-c.mov",
            "webm": "https://example.invalid/a-to-c.webm"
          },
          "conditions": [
            {
              "input": "behavior::pointerHover",
              "op": "==",
              "value": false
            },
            {
              "input": "behavior::working",
              "op": "==",
              "value": true
            }
          ]
        },
        {
          "id": "c-to-a",
          "source": "c",
          "target": "a",
          "isLoop": false,
          "duration": 1,
          "videos": {
            "hevc": "https://example.invalid/c-to-a.mov",
            "webm": "https://example.invalid/c-to-a.webm"
          },
          "conditions": [
            {
              "input": "behavior::working",
              "op": "==",
              "value": false
            }
          ]
        }
      ],
      "inputs": []
    }
  },
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": ["pose:a", "shown:loop-a"]
      }
    },
    {
      "hover": true,
      "expect": {
        "clock": 0,
        "pose": "a",
        "clip": "a-to-b",
        "next": null,
        "events": ["shown:a-to-b"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 1000,
        "pose": "b",
        "clip": "loop-b",
        "next": null,
        "events": ["pose:b", "shown:loop-b"]
      }
    },
    {
      "advance": 500,
      "expect": {
        "clock": 1500,
        "pose": "b",
        "clip": "loop-b",
        "next": null,
        "events": []
      }
    },
    {
      "hover": false,
      "expect": {
        "clock": 1500,
        "pose": "b",
        "clip": "b-to-a",
        "next": null,
        "events": ["shown:b-to-a"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 2500,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": ["pose:a", "shown:loop-a"]
      }
    },
    {
      "advance": 1000,
      "expect": {
        "clock": 3500,
        "pose": "a",
        "clip": "loop-a",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 3500,
        "pose": "a",
        "clip": "loop-a",
        "next": {
          "clip": "a-to-c",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 6500,
        "pose": "a",
        "clip": "a-to-c",
        "next": null,
        "events": ["shown:a-to-c"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 7500,
        "pose": "c",
        "clip": "loop-c",
        "next": null,
        "events": ["pose:c", "shown:loop-c"]
      }
    },
    {
      "set": ["working", false],
      "expect": {
        "clock": 7500,
        "pose": "c",
        "clip": "loop-c",
        "next": {
          "clip": "c-to-a",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "hover": true,
      "expect": {
        "clock": 7500,
        "pose": "c",
        "clip": "loop-c",
        "next": {
          "clip": "c-to-a",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "advance": 500,
      "expect": {
        "clock": 8000,
        "pose": "c",
        "clip": "loop-c",
        "next": {
          "clip": "c-to-a",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "hover": false,
      "expect": {
        "clock": 8000,
        "pose": "c",
        "clip": "loop-c",
        "next": {
          "clip": "c-to-a",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 11500,
        "pose": "c",
        "clip": "c-to-a",
        "next": null,
        "events": ["shown:c-to-a"]
      }
    }
  ]
}
