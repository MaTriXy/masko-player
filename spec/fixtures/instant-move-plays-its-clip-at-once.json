{
  "name": "instant-move-plays-its-clip-at-once",
  "about": "A move whose condition was set with instant starts at once, mid-loop, and plays its own clip, as a person's start does.",
  "rules": ["5.8", "5.2"],
  "canvas": "ko-coffee",
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "advance": 1500,
      "expect": {
        "clock": 1500,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": []
      }
    },
    {
      "set": ["working", true],
      "instant": true,
      "expect": {
        "clock": 1500,
        "pose": "idle",
        "clip": "enter-laptop-working",
        "next": null,
        "events": ["shown:enter-laptop-working"]
      }
    },
    {
      "clipEnded": true,
      "expect": {
        "clock": 3786,
        "pose": "laptop-working",
        "clip": "loop-laptop-working",
        "next": null,
        "events": ["pose:laptop-working", "shown:loop-laptop-working"]
      }
    }
  ]
}
