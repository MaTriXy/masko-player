{
  "name": "load-accepts-fractional-priority",
  "about": "A fractional priority loads and ranks as a number.",
  "rules": ["1.3", "4.1"],
  "canvas": "otto",
  "patch": {
    "edges": {
      "idle-to-watching": {
        "priority": 30.5
      }
    }
  },
  "steps": [
    {
      "start": true,
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": null,
        "events": ["pose:idle", "shown:loop-idle"]
      }
    },
    {
      "set": ["working", true],
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "idle-to-watching",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "set": ["attention", true],
      "expect": {
        "clock": 0,
        "pose": "idle",
        "clip": "loop-idle",
        "next": {
          "clip": "idle-to-watching",
          "at": "end"
        },
        "events": []
      }
    },
    {
      "loopEnded": true,
      "expect": {
        "clock": 4000,
        "pose": "idle",
        "clip": "idle-to-watching",
        "next": null,
        "events": ["shown:idle-to-watching"]
      }
    }
  ]
}
